@HostAddress = http://localhost:5166

### ================= Categories =================

### Get all categories
GET {{HostAddress}}/api/Categories
Accept: application/json

### Create a category
# @name createCategory
POST {{HostAddress}}/api/Categories
Content-Type: application/json

{
  "name": "Streaming"
}

### Create the same category name again -> expect 409
POST {{HostAddress}}/api/Categories
Content-Type: application/json

{
  "name": "streaming"
}

### Get the category created above
GET {{HostAddress}}/api/Categories/{{createCategory.response.body.$.id}}
Accept: application/json

### Update the category created above
PUT {{HostAddress}}/api/Categories/{{createCategory.response.body.$.id}}
Content-Type: application/json

{
  "name": "Streaming & VOD"
}

### Get a category that doesn't exist -> expect 404
GET {{HostAddress}}/api/Categories/999999
Accept: application/json

### Create a category with an empty name -> expect 400
POST {{HostAddress}}/api/Categories
Content-Type: application/json

{
  "name": ""
}

### ================= Subscriptions =================

### Create a second category to attach the subscription to
# @name createCategoryForSubscription
POST {{HostAddress}}/api/Categories
Content-Type: application/json

{
  "name": "Software"
}

### Get all subscriptions
GET {{HostAddress}}/api/Subscriptions
Accept: application/json

### Create a subscription
# @name createSubscription
POST {{HostAddress}}/api/Subscriptions
Content-Type: application/json

{
  "name": "Netflix",
  "description": "Streaming service",
  "price": 12.99,
  "billingCycle": 1,
  "startDate": "2026-01-01T00:00:00Z",
  "categoryId": {{createCategoryForSubscription.response.body.$.id}}
}

### Create the same subscription name in the same category again -> expect 409
POST {{HostAddress}}/api/Subscriptions
Content-Type: application/json

{
  "name": "NETFLIX",
  "description": "Streaming service",
  "price": 12.99,
  "billingCycle": 1,
  "startDate": "2026-01-01T00:00:00Z",
  "categoryId": {{createCategoryForSubscription.response.body.$.id}}
}

### Create a subscription with a category that doesn't exist -> expect 400
POST {{HostAddress}}/api/Subscriptions
Content-Type: application/json

{
  "name": "Spotify",
  "description": "Music",
  "price": 9.99,
  "billingCycle": 1,
  "startDate": "2026-01-01T00:00:00Z",
  "categoryId": 999999
}

### Create a subscription with a billingCycle that isn't a defined enum value -> expect 400
POST {{HostAddress}}/api/Subscriptions
Content-Type: application/json

{
  "name": "Spotify",
  "description": "Music",
  "price": 9.99,
  "billingCycle": 999,
  "startDate": "2026-01-01T00:00:00Z",
  "categoryId": {{createCategoryForSubscription.response.body.$.id}}
}

### Get the subscription created above
GET {{HostAddress}}/api/Subscriptions/{{createSubscription.response.body.$.id}}
Accept: application/json

### Update the subscription created above (price is not editable here)
PUT {{HostAddress}}/api/Subscriptions/{{createSubscription.response.body.$.id}}
Content-Type: application/json

{
  "name": "Netflix Premium",
  "description": "Updated plan",
  "billingCycle": 1,
  "startDate": "2026-01-01T00:00:00Z",
  "endDate": null,
  "categoryId": {{createCategoryForSubscription.response.body.$.id}}
}

### Get a subscription that doesn't exist -> expect 404
GET {{HostAddress}}/api/Subscriptions/999999
Accept: application/json

### Get upcoming renewals in the next 30 days (default) -> expect 200, includes the subscription above
GET {{HostAddress}}/api/Subscriptions/upcoming
Accept: application/json

### Get upcoming renewals in the next 1 day -> expect 200, excludes the subscription above (its next renewal is further out)
GET {{HostAddress}}/api/Subscriptions/upcoming?withinDays=1
Accept: application/json

### Change the price of the subscription created above -> expect 200, records a PriceHistory
PUT {{HostAddress}}/api/Subscriptions/{{createSubscription.response.body.$.id}}/price
Content-Type: application/json

{
  "newPrice": 14.99
}

### Change it again to the SAME price -> expect 400
PUT {{HostAddress}}/api/Subscriptions/{{createSubscription.response.body.$.id}}/price
Content-Type: application/json

{
  "newPrice": 14.99
}

### Change the price of a subscription that doesn't exist -> expect 404
PUT {{HostAddress}}/api/Subscriptions/999999/price
Content-Type: application/json

{
  "newPrice": 5
}

### Get the expenses summary while the subscription above is still Active -> expect 200
GET {{HostAddress}}/api/Expenses/summary
Accept: application/json

### Change the status of the subscription created above to Paused -> expect 200
PUT {{HostAddress}}/api/Subscriptions/{{createSubscription.response.body.$.id}}/status
Content-Type: application/json

{
  "newStatus": 1
}

### Change it again to the SAME status -> expect 400
PUT {{HostAddress}}/api/Subscriptions/{{createSubscription.response.body.$.id}}/status
Content-Type: application/json

{
  "newStatus": 1
}

### Change the status of a subscription that doesn't exist -> expect 404
PUT {{HostAddress}}/api/Subscriptions/999999/status
Content-Type: application/json

{
  "newStatus": 1
}

### Change the status of the subscription above to a newStatus that isn't a defined enum value -> expect 400
PUT {{HostAddress}}/api/Subscriptions/{{createSubscription.response.body.$.id}}/status
Content-Type: application/json

{
  "newStatus": 999
}

### Get the expenses summary again, now that the subscription above is Paused -> expect 200 (excludes it)
GET {{HostAddress}}/api/Expenses/summary
Accept: application/json

### Delete the category used by the subscription above while it still has a subscription -> expect 409
DELETE {{HostAddress}}/api/Categories/{{createCategoryForSubscription.response.body.$.id}}

### Delete the subscription created above
DELETE {{HostAddress}}/api/Subscriptions/{{createSubscription.response.body.$.id}}

### ================= Price Histories (read-only) =================

### Get all price history records
GET {{HostAddress}}/api/PriceHistories
Accept: application/json

### Get price history records filtered by subscription
GET {{HostAddress}}/api/PriceHistories?subscriptionId={{createSubscription.response.body.$.id}}
Accept: application/json

### Get a price history record that doesn't exist -> expect 404
GET {{HostAddress}}/api/PriceHistories/999999
Accept: application/json

### ================= Cleanup =================

### Delete the category created for the subscription above
DELETE {{HostAddress}}/api/Categories/{{createCategoryForSubscription.response.body.$.id}}

### Delete the first category created above
DELETE {{HostAddress}}/api/Categories/{{createCategory.response.body.$.id}}
